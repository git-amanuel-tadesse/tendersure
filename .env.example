# Copy to .env and fill in. .env is git-ignored. Everything sent to a model is
# anonymised first; see tendersure/privacy.py and `python -m tendersure privacy-check`.

# Which backend: openrouter or gemini
TENDERSURE_PROVIDER=gemini

# --- gemini: your own Google key. PAID TIER ONLY: on the unpaid tier Google may
# use prompts to improve its products and human reviewers may read them.
GEMINI_API_KEY=
GEMINI_PAID_TIER=no          # set to yes once billing is enabled on the key's Google Cloud project
TENDERSURE_MODEL=gemini-4-argon

# --- openrouter (alternative): routed only to providers that do not store or train on data
# OPENROUTER_API_KEY=
# TENDERSURE_MODEL=google/gemini-4-argon
# TENDERSURE_FALLBACKS=google/gemini-3.8-flash
